{
  "name": "relik",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --watch server/index.js",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"npm:dev\" \"npm:server\"",
    "build": "vite build",
    "start": "vite build && node server/index.js --site",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "express": "^5.3.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^9.2.5",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
